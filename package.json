{
  "name": "wbcpa-super-agent",
  "version": "1.0.0",
  "description": "WBCPA Command Center — 24/7 AI-Powered CPA & Wealth Building Coach",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "prestart": "npm run build || echo 'Prestart build failed — server will retry at boot.'",
    "postinstall": "npm run build || echo 'Postinstall build skipped — server will retry at boot.'",
    "dev": "concurrently \"nodemon server/index.js\" \"vite --config vite.config.js --port 5173\"",
    "build": "vite build",
    "server": "node server/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@supabase/supabase-js": "^2.45.4",
    "@vitejs/plugin-react": "^4.3.2",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "google-auth-library": "^9.14.1",
    "googleapis": "^144.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "openai": "^4.67.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "twilio": "^5.3.3",
    "vite": "^5.4.8"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.7"
  }
}
