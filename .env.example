# ─────────────────────────────────────────────────────────────────────────────
# WBCPA Super Agent — Environment Variables
# Copy this file to .env (or add as Replit Secrets) and fill in real values.
# The app boots cleanly with zero env vars set — all services fall back to
# realistic mock data in that case.
# ─────────────────────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=production

# App Security ────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string
INTERNAL_API_KEY=another_random_string_for_bland_ai_callbacks
REPLIT_URL=https://your-repl-name.replit.app

# Supabase ────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Bland AI (Voice Agent) ──────────────────────────────────────────────────────
BLAND_API_KEY=your_bland_api_key
BLAND_AGENT_ID=

# Twilio (Phone) ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+12025551234

# OpenAI (Email drafting) ─────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your_openai_key

# Google OAuth (Gmail + Calendar) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=https://your-repl.replit.app/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=your_refresh_token
GOOGLE_CALENDAR_ID=primary

# WB CPA Config ───────────────────────────────────────────────────────────────
WBCPA_STAFF_EMAIL=staff@wbcpa.com
WBCPA_STAFF_PHONE=+12025559999
